# Gemini API key for board recognition fix (removes OCR errors, corrects non-words)
# Get a key at https://aistudio.google.com/app/apikey
# Production: Add GEMINI_API_KEY in Vercel Project Settings → Environment Variables
# Local: Copy to .env or .env.local and run `npm run dev` (Vite proxies /api/gemini to port 3001)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs — speech-to-text (Scribe) + text-to-speech (used for AI Chat voice and assistant TTS)
# Get a key at https://elevenlabs.io — never commit real keys; use .env or .env.local (gitignored).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice: Rachel (change in ElevenLabs dashboard → Voice ID)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# STT model: scribe_v1 | scribe_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1
ELEVENLABS_STT_LANGUAGE=en
# TTS: prefer turbo for fewer credits per character (see ElevenLabs pricing)
ELEVENLABS_TTS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
